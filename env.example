# Rewind Data Processor Environment Configuration
# Copy this file to .env and customize the values for your setup

# Project Configuration
PROJECT_NAME="my_rewind_project"

# External Drive Configuration (optional)
EXTERNAL_DRIVE="/Volumes/your_external_drive"
EXTERNAL_PROJECT_DIR="$EXTERNAL_DRIVE/$PROJECT_NAME"

# Processing Configuration
ENABLE_OCR="true"
ENABLE_TRANSCRIPTION="true"
ENABLE_SPEAKER_DIARIZATION="false"

# OCR Configuration
OCR_METHOD="auto"
OCR_CONFIDENCE_THRESHOLD="0.8"

# Audio Transcription Configuration
TRANSCRIPTION_LANGUAGE="en-US"
TRANSCRIPTION_FORMAT="text"
TRANSCRIPTION_INCLUDE_METADATA="true"

# Pipeline Configuration
PIPELINE_PARALLEL_PROCESSING="false"
PIPELINE_BATCH_SIZE="10"
PIPELINE_CLEANUP_TEMP_FILES="true"

# Optional: API Keys (if external services are added in the future)
# OPENAI_API_KEY=""
# GOOGLE_CLOUD_API_KEY=""
# AZURE_SPEECH_KEY="" 